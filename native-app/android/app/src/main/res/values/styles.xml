<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      The theme that is actually live once the app is running: Capacitor's
      BridgeActivity calls setTheme(R.style.AppTheme_NoActionBar) in onCreate,
      overriding whatever the manifest declared on the activity. Style the system
      bars here or the change has no visible effect.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!--
          Android 15+ (targetSdk 35+) forces edge-to-edge and ignores these two,
          drawing the web content under the bars instead — which the CSS already
          handles via viewport-fit=cover and env(safe-area-inset-*). They are what
          fixes API 34 and below, where the bars are opaque and were defaulting to
          grey and black. Harmless on newer platforms, so no version split needed.
        -->
        <item name="android:statusBarColor">@color/systemBarTop</item>
        <item name="android:navigationBarColor">@color/systemBarBottom</item>
        <item name="android:windowLightStatusBar">@bool/lightSystemBars</item>
        <!-- API 27+; silently ignored on 24-26, which simply keep light icons. -->
        <item name="android:windowLightNavigationBar">@bool/lightSystemBars</item>
    </style>

    <!--
      The splash theme. Given the same bar colours so launch doesn't flash a grey
      status bar and a black navigation bar before the WebView takes over.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/systemBarTop</item>
        <item name="android:navigationBarColor">@color/systemBarBottom</item>
        <item name="android:windowLightStatusBar">@bool/lightSystemBars</item>
        <item name="android:windowLightNavigationBar">@bool/lightSystemBars</item>
    </style>
</resources>
