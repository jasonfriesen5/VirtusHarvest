# Copy to keystore.properties and fill in. NEVER commit the real file.
# Create the keystore yourself so only you ever see the passwords:
#
#   keytool -genkey -v -keystore virtus-feed-upload.jks \
#       -alias virtus-feed -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=../virtus-feed-upload.jks
storePassword=
keyAlias=virtus-feed
keyPassword=
