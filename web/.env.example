# Copy to .env for local development. On Netlify, set these under
# Site configuration → Environment variables (they are baked in at build
# time, so a change here needs a redeploy to take effect).
#
# Both Supabase values are safe in the browser: the publishable key only
# grants what row-level security allows, which is why every table is scoped
# by user_id. Never put the service_role key here — it bypasses RLS.
VITE_SUPABASE_URL=https://cbsgtpuxfalsxtpksdjz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ibu9OMe87NrdxUx5Qn3nVQ_O11ICeyO

# Same Google Maps key the phone app uses. It is referrer-restricted, so
# view.virtusharvest.com (and http://localhost:5180 for local work) must be
# added to the key's allowed referrers in Google Cloud Console or the map
# silently fails to load.
VITE_GOOGLE_MAPS_KEY=AIzaSyDcZniF_xTFBPqqt1l2PYA1cc-MckJXWtk
