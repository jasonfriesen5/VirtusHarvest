# Copy to .env for local development. On Netlify these are set under
# Site configuration → Environment variables and baked in at build time, so a
# change there needs a redeploy.
#
# The publishable key is safe in the browser: it only grants what row-level
# security allows, and every vf_* table is scoped by user_id. Never put the
# service_role key here — it bypasses RLS.
VITE_SUPABASE_URL=https://tzafqxhaemgieehuolbp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7-Jgtof9zyRZiohzIgsksw_a7aA1bzg
