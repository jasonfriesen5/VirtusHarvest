# Apple and Google both have these URLs on file for the store listings, so they
# must resolve at the site root. They are listed before the SPA catch-all
# because the first matching rule wins — the catch-all would otherwise hand
# /privacy to the React app, which has no such route.
/privacy          /privacy.html         200
/support          /support.html         200
/delete-account   /delete-account.html  200

# React Router owns every other path.
/*          /index.html     200
